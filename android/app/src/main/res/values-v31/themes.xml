<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash screen: keep it dark like the app (it follows the system's light theme otherwise). -->
    <style name="Theme.Tuno" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">#121212</item>
    </style>
</resources>
